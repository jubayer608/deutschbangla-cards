# Phase 0 — environment template. PLACEHOLDER NAMES ONLY — never put real
# values in this file. Copy to `.env.local` (local dev) and set the same
# variables in Vercel → Project Settings → Environment Variables.

# Neon Postgres connection string (pooled). Get it from Neon dashboard →
# your project → Connection Details. Example shape (NOT a real value):
# postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Direct (non-pooled) connection, for `prisma migrate` / `db push`.
# Same as DATABASE_URL but with ?sslmode=require and no pooling params.
DIRECT_URL=""

# Auth.js secret — generate with:  npx auth secret
# (or: openssl rand -base64 32). Used to sign session cookies.
AUTH_SECRET=""

# Google OAuth (Google Cloud Console → APIs & Services → Credentials →
# OAuth 2.0 Client ID, type "Web application"). See SETUP.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public site URL (used by NextAuth for callback URLs in production).
NEXTAUTH_URL="https://deutschbangla-cards.vercel.app"
