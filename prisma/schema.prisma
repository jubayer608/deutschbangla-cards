// ULLUK — Phase 0 (Foundation) database schema.
//
// Auth.js (NextAuth v5) models + app tables. Postgres (Neon) only.
// Setup: `npx prisma db push` (or `prisma migrate dev`) after setting
// DATABASE_URL — see SETUP.md. Never commit a real DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for `prisma migrate` / `db push` —
  // pooled Neon URLs can break migrations (PgBouncer + prepared statements).
  directUrl = env("DIRECT_URL")
}

// ── Auth.js (NextAuth v5) ────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // Public profile handle for Phase 1 (/profile/[username]).
  // Nullable: set later in settings; unique when present.
  username String? @unique

  accounts        Account[]
  sessions        Session[]
  progress        UserProgress?
  xpEvents        XpEvent[]
  badges          Badge[]
  followers       Follow[]       @relation("Following")
  following       Follow[]       @relation("Follower")
  notifications   Notification[]
  emailPreference EmailPreference?
  settings        UserSettings?
  pushSubscriptions PushSubscription[]
  mailLogs        MailLog[]
  createdDuels    Duel[] @relation("DuelCreator")
  joinedDuels     Duel[] @relation("DuelOpponent")
  wordReviews     WordReview[]
  certificates    Certificate[]
  submissions     Submission[]
  chatMessages    ChatMessage[]
  chatPresence    ChatPresence?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Phase 5 — A1 Certificate (one per user, idempotent issue) ───────

model Certificate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Public verification code, e.g. "ULLUK-KQ7X-2P9M".
  code String @unique
  // Display name at issue time (frozen — later renames don't rewrite it).
  name String
  // Snapshot at issue time: { lessonsDone, knownWords, quizCompleted, xp, level }.
  criteria Json
  issuedAt DateTime @default(now())

  @@index([userId])
}

// ── Phase 5 — Community Submissions ──────────────────────────────────

model Submission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // word | phrase | lesson_idea
  type String
  // word: { german, bangla, article?, example?, category? }
  // phrase: { german, bangla, context? }
  // lesson_idea: { title, description }
  payload Json
  // pending | approved | rejected
  status String @default("pending")
  moderatorNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ── Phase 5 — SM-2 spaced repetition ──────────────────────────────────────

model WordReview {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Word id from the static curriculum (data/words.ts, e.g. "familie-01").
  // NOT an FK: words live in static data, not in the DB.
  wordId String

  // SM-2 state (see lib/sm2.ts for the algorithm).
  easeFactor   Float   @default(2.5)
  intervalDays Int     @default(0)
  repetitions  Int     @default(0)
  lapses       Int     @default(0)
  // When the word is due again. New words have no row yet — a missing
  // row means "new, due now"; rows are created on the first answer.
  nextReviewAt DateTime @default(now())
  lastQuality  Int?

  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId])
  @@index([nextReviewAt])
}

// ── Phase 5 — quiz duel (1v1, realtime-ish via polling) ─────────────────

model Duel {
  id String @id @default(cuid())
  // 6-char uppercase invite code, e.g. "KQ7X2P" — the shareable handle.
  code String @unique

  creatorId  String
  creator    User   @relation("DuelCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  opponentId String?
  opponent   User?  @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  // waiting | playing | finished
  status String @default("waiting")

  // Quiz category: vocab | grammar | mixed. Difficulty: easy | medium | hard | mixed.
  category   String
  difficulty String

  // The 10 questions, frozen at creation — IDENTICAL for both players.
  // Shape: QuizQuestion[] from lib/quiz-questions.ts (incl. `answer` —
  // never sent to clients; the answer endpoint validates server-side).
  questions Json

  // Per-user progress, keyed by user id:
  // { [userId]: { answers: (number|null)[10], score: number,
  //   finishedAt: string|null } }
  // answers[i] = chosen option index, or null if unanswered.
  scores Json @default("{}")

  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([creatorId])
  @@index([opponentId])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── App tables (Phase 0+) ────────────────────────────────────────────────

model UserProgress {
  id String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  xp        Int       @default(0)
  // Level is derived: floor(xp / 200) + 1 (same formula as the site UI).
  // Stored for cheap leaderboard/profile reads; recomputed on every merge.
  level       Int       @default(1)
  streak      Int       @default(0)
  lastStudyDate DateTime?
  reviewed    Int       @default(0)

  // Phase 5 — Streak Freeze: auto-spent when the user returns after
  // exactly one missed day (gap of 2 days since last activity).
  // Earned +1 per streak multiple of 7 (7, 14, 21…), max 3 stored.
  streakFreezes       Int @default(0)
  // Highest multiple-of-7 milestone already paid out (per run).
  lastFreezeMilestone Int @default(0)

  // Merged from localStorage on first login (see /api/sync-progress):
  // union of known word ids, union of completed lesson ids.
  knownWords  String[]
  lessonsDone Int[]

  // Per-mode best scores, e.g. { "vocab-easy": 9, "grammar-hard": 7 }.
  // Per-key MAX merge — never overwritten with a lower value.
  quizBest Json @default("{}")
  // Per-mode best single-round scores from `dbc-quizbest-score-*` keys.
  quizBestScores Json @default("{}")
  // "YYYY-MM-DD" -> xp earned that day. Per-day MAX merge (not sum:
  // the same day's activity must not be double-counted across devices).
  activity Json @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  source    String // e.g. "quiz", "lesson", "word", "sync" (Phase 0: sync only)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Badge {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String // e.g. "streak-7", "words-100", "grammar-master"
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // e.g. "streak", "badge", "follow", "word-of-day"
  title     String
  body      String?
  read      Boolean  @default(false)
  // Phase 3 — who triggered it (e.g. the follower) + where it links to.
  // actorId is a plain id (no FK: the actor's account may be gone and the
  // notification should survive). dedupKey prevents duplicate unread rows
  // for the same event, e.g. "follow:<actorId>" or "badge:<key>".
  actorId  String?
  link     String?
  dedupKey String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, dedupKey])
}

model EmailPreference {
  id       String @id @default(cuid())
  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  welcome       Boolean @default(true)
  weeklyReport  Boolean @default(true)
  streakNudge   Boolean @default(true)
  wordOfDay     Boolean @default(false)
}

// ── Phase 3 — web push subscriptions ──────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Browser push endpoint — globally unique per subscription.
  endpoint  String   @unique
  // { p256dh, auth } keys from the Push API subscription (Json, not Text:
  // web-push accepts the object as-is).
  keys      Json
  createdAt DateTime @default(now())

  @@index([userId])
}


// ── Phase 4 — mail log (idempotency + audit for Resend sends) ───────────

model MailLog {
  id String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // welcome | weekly | streak | wordofday
  kind String
  // Dedup window: "welcome" (once ever) | ISO week "2026-W42" |
  // calendar day "2026-10-15". Unique with (userId, kind) so a send is
  // never duplicated for the same window, even if cron retries/races.
  dedupKey String
  sentAt DateTime @default(now())
  // Free-form audit (e.g. { weekXp: 340 } for weekly reports).
  meta Json?

  @@unique([userId, kind, dedupKey])
  @@index([userId, kind])
}

model UserSettings {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Daily XP target shown on the profile / progress pages.
  dailyGoalXp Int @default(50)
  // Reminder time "HH:MM" (local time, as typed by the user) or null.
  reminderTime String?
  // Preferred quiz/lesson difficulty: easy | medium | hard | mixed.
  difficulty String @default("mixed")
  // Profile visibility: public | friends | private.
  privacy String @default("public")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Global Community Chat (one shared room for everyone) ──────────────

model ChatMessage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Plain text only (max 500 chars, enforced in the API). Rendered as
  // plain text — never dangerouslySetInnerHTML.
  content String

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Heartbeat presence for the Community Chat "X jon online" counter.
// One row per user (userId is the PK). The client sends a heartbeat
// every 30s while a chat UI is open; GET /api/chat counts rows seen
// within the last 90s as "online". NOT true WebSocket presence —
// Vercel serverless can't hold persistent connections (see lib/chat.ts).
// Stale rows need no cleanup job: the recency filter ignores them.
model ChatPresence {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSeenAt DateTime @default(now())

  @@index([lastSeenAt])
}
